{
  "name": "mr-chungus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "supabase:start": "set -a; [ -f supabase/.env ] && . supabase/.env; set +a; HLS_DISCORD_OAUTH_CLIENT_ID=\"$SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENTID\" HLS_DISCORD_OAUTH_SECRET=\"$SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET\" HLS_GOOGLE_OAUTH_CLIENT_ID=\"$SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENTID\" HLS_GOOGLE_OAUTH_SECRET=\"$SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET\" npx --yes supabase@latest start",
    "supabase:reset": "set -a; [ -f supabase/.env ] && . supabase/.env; set +a; npx --yes supabase@latest db reset",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:edge && npm run test:acdb",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:edge": "node --experimental-vm-modules --test tests/edge-functions/notifications.test.mjs",
    "test:acdb": "node --experimental-vm-modules --test tests/acdb/handler.test.mjs",
    "test:db": "npx --yes supabase@latest test db"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.0.9",
    "astro": "^7.4.12",
    "html2canvas": "^1.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.9"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
