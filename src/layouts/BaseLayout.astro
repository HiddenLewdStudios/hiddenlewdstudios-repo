---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Hidden Lewd Studio — supporter commission and request portal.",
} = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0f13" />
    <title>{title}</title>
  </head>
  <body>
    <main class="site-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Legal and help links">
        <a href={`${baseUrl}terms/`}>Terms</a>
        <a href={`${baseUrl}privacy/`}>Privacy</a>
        <a href={`${baseUrl}commission-policy/`}>Commission policy</a>
        <a href={`${baseUrl}commissions/`}>Commissions</a>
        <a href={`${baseUrl}gallery/`}>Gallery</a>
        <a href={`${baseUrl}faq/`}>FAQ</a>
        <a href={`${baseUrl}contact/`}>Contact</a>
      </nav>
      <p>© {new Date().getFullYear()} Hidden Lewd Studio. Private test build.</p>
    </footer>
  </body>
</html>
