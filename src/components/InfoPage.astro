---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={`${title} | Hidden Lewd Studio`}>
  <article class="section-card info-page">
    <a class="back-link" href={baseUrl}>← Back to the request portal</a>
    <h1>{title}</h1>
    <slot />
  </article>
</BaseLayout>
